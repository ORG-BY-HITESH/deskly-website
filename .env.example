# ─── Environment ────────────────────────────────────────────────────────
# Set to 'production' on Vercel / live server (enables secure cookies,
# enforces JWT_SECRET, sanitises error output)
NODE_ENV=development

# ─── WorkOS Configuration ───────────────────────────────────────────────
# Get these from https://dashboard.workos.com
# IMPORTANT: In production, use LIVE keys (sk_live_*), not test keys
WORKOS_API_KEY=sk_test_your_api_key_here
WORKOS_CLIENT_ID=client_your_client_id_here

# ─── JWT ────────────────────────────────────────────────────────────
# REQUIRED in production — Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters, random, and different per environment
JWT_SECRET=change-me-to-a-strong-random-string-at-least-32-chars

# ─── Server ─────────────────────────────────────────────────────────
PORT=4000
BASE_URL=https://www.deskly.in

# Deep link scheme used by the Electron desktop app
DESKTOP_SCHEME=deskly

# ─── Security ────────────────────────────────────────────────────────
# Force secure cookies in development (HTTPS required)
# Only set this if testing HTTPS behavior locally
# FORCE_SECURE_COOKIES=false

# ─── Optional: Error Tracking ────────────────────────────────────────
# For production monitoring, configure one of:
# SENTRY_DSN=https://...@sentry.io/...
# DATADOG_API_KEY=...
# NEW_RELIC_LICENSE_KEY=...
